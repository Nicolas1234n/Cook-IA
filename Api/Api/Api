

export default async function handler(req, res) {
  const { message } = req.body;
  
  const keys = [process.env.GROQ_KEY_1, process.env.GROQ_KEY_2, process.env.GROQ_KEY_3, process.env.GROQ_KEY_4, process.env.GROQ_KEY_5];
  const groqKey = keys[Math.floor(Math.random() * keys.length)];

  const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
    method: 'POST',
    headers: { 'Authorization': `Bearer ${groqKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ model: 'llama-3.1-8b-instant', messages: [{ role: 'user', content: message }] })
  });

  const data = await response.json();
  res.status(200).json({ reply: data.choices[0].message.content });
}
